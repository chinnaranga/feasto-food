rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper functions ─────────────────────────────────────────────────────

    // Is the incoming request from a signed-in Firebase user?
    function isSignedIn() {
      return request.auth != null;
    }

    // Is the signed-in user the owner of this resource path?
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // ─── Restaurants (public catalog) ─────────────────────────────────────────
    // Public read — any visitor can browse restaurants and menus.
    // Writes are server-side only (no client writes permitted).
    match /restaurants/{restaurantId} {
      allow read: if true;
      allow write: if false;

      match /menu/{itemId} {
        allow read: if true;
        allow write: if false;
      }
    }

    // ─── Users & their private sub-collections ────────────────────────────────
    // Each authenticated user can only access their own document tree.
    match /users/{uid} {
      allow read, write: if isOwner(uid);

      // Orders placed by this user
      match /orders/{orderId} {
        allow read:   if isOwner(uid);
        allow create: if isOwner(uid);
        allow update: if isOwner(uid);
        allow delete: if false;
      }

      // Saved delivery addresses
      match /addresses/{addressId} {
        allow read, write: if isOwner(uid);
      }

      // In-app notifications
      match /notifications/{notificationId} {
        allow read, write: if isOwner(uid);
      }

      // Customer support tickets
      match /supportTickets/{ticketId} {
        allow read:   if isOwner(uid);
        allow create: if isOwner(uid);
        allow update: if isOwner(uid);
        allow delete: if false;
      }

      // Active cart items
      match /cart/{itemId} {
        allow read, write: if isOwner(uid);
      }

      // Loyalty points & rewards
      match /rewards/{docId} {
        allow read:           if isOwner(uid);
        allow create, update: if isOwner(uid);
        allow delete:         if false;
      }
    }

    // ─── Global orders collection ─────────────────────────────────────────────
    // Users can only read/write orders where userId matches their own uid.
    match /orders/{orderId} {
      allow read:   if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if false;
    }

    // ─── Deny everything else by default ─────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
