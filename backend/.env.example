# Server Configuration
PORT=5000
NODE_ENV=development

# Database & Cache Configurations
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/feasto_v2?retryWrites=true&w=majority
REDIS_URL=redis://localhost:6379

# Authentication & Security
JWT_SECRET=super-secret-access-token-key-change-in-production
JWT_REFRESH_SECRET=super-secret-refresh-token-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Client Portal URLs
CLIENT_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
RIDER_URL=http://localhost:3002
RESTAURANT_URL=http://localhost:3003

# Cloud Services
CLOUDINARY_CLOUD_NAME=feasto_cloud
CLOUDINARY_API_KEY=1234567890
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Push Notifications (Firebase Cloud Messaging)
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"feasto-app","private_key_id":"key","private_key":"-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk@feasto-app.iam.gserviceaccount.com"}
FCM_ENABLED=true

# External Services
GOOGLE_MAPS_API_KEY=AIzaSyYourGoogleMapsApiKeyHere

# Network & Security Controls
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100

# NVIDIA Nemotron AI Service
AI_PROVIDER=nemotron
AI_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NEMOTRON_API_KEY=nvapi-your-secret-nvidia-key
NEMOTRON_BASE_URL=https://integrate.api.nvidia.com/v1
NEMOTRON_TIMEOUT_MS=15000
NEMOTRON_MAX_RETRIES=2
