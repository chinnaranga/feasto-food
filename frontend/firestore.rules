rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default: Deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true || 
        request.auth.token.email == "admin@aerobite.com" ||
        request.auth.token.email == "admin@feasto.food" ||
        request.auth.token.email.matches(".*@aerobite[.]com")
      );
    }


    // --- Users Collection ---
    match /users/{uid} {
      allow read, write: if isOwner(uid) || isAdmin();
      
      match /addresses/{id} { allow read, write: if isOwner(uid) || isAdmin(); }
      match /ai_memory/{id} { allow read, write: if isOwner(uid) || isAdmin(); }
    }

    // --- Riders Collection ---
    match /riders/{uid} {
      allow read: if isOwner(uid) || isAdmin(); // Riders see own profile
      allow write: if isOwner(uid) || isAdmin(); // Riders update status/location
    }

    // --- Public Data ---
    match /restaurants/{id} {
      allow read: if true;
      allow write: if isAdmin();
      
      match /menu/{itemId} { allow read: if true; allow write: if isAdmin(); }
    }
    
    match /app_config/global {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- Orders (Complex Logic) ---
    // --- Orders (Complex Logic) ---
    match /orders/{orderId} {
      // Create: Users can create orders
      allow create: if isSignedIn();
      
      // Read: Owner, Assigned Rider, Admin, or Restaurant Owner
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid || 
        resource.data.riderId == request.auth.uid ||
        isAdmin() ||
        // Allow list queries for admins
        (request.auth.token.email.matches(".*@aerobite[.]com") || request.auth.token.email == "admin@feasto.food") ||
        // Allow restaurant owner to read orders for their restaurant
        (resource.data.restaurantId != null && get(/databases/$(database)/documents/restaurants/$(resource.data.restaurantId)).data.ownerId == request.auth.uid)
      );
      
      // Update: 
      // - User (Cancel if pending)
      // - Rider (Update status)
      // - Admin (Any)
      // - Restaurant Owner (Update status)
      allow update: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        resource.data.riderId == request.auth.uid || 
        isAdmin() ||
        (request.auth.token.email.matches(".*@aerobite[.]com") || request.auth.token.email == "admin@feasto.food") ||
        (resource.data.restaurantId != null && get(/databases/$(database)/documents/restaurants/$(resource.data.restaurantId)).data.ownerId == request.auth.uid)
      );
    }
    
    // --- Available Orders (For Riders to claim) ---
    // Often handled by backend assignment, but if riders query headers:
    // match /orders/{orderId} where status == 'ready' ... 
    // Firestore rules don't filter queries, query filters data.

    // --- Wallets ---
    match /wallets/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isAdmin(); // Only system/admin credits wallet
    }
    
    // --- Payments ---
    match /payments/{id} {
      allow read: if resource.data.userId == request.auth.uid || isAdmin();
      allow write: if false; // Cloud Functions handle creation
    }
  }
}
